<!doctype html><html><head><meta charset="utf-8"><title>pysentra report</title><style>body{font:15px system-ui;max-width:1100px;margin:auto;padding:2rem;color:#172033}article{border:1px solid #ccd3df;padding:1rem;margin:1rem 0;border-radius:8px}pre{white-space:pre-wrap;background:#f4f6f9;padding:.8rem}h1{color:#342d73}@media print{article{break-inside:avoid}}</style></head><body><h1>pysentra security report</h1><p><b>Target:</b> {{target}}<br><b>Timestamp:</b> {{timestamp}}<br><b>Weighted risk:</b> {{weighted_risk_score}}</p><h2>Summary</h2><p>{{counts}}</p>{% for f in findings %}<article><h2>{{f.severity}} — {{f.title}}</h2><p><b>Scope:</b> {{f.scope_area}} · <b>CVSS:</b> {{f.cvss_score}} ({{f.cvss_vector}})</p><p>{{f.description}}</p><p><b>Component:</b> {{f.affected_component}}</p><p><b>Impact:</b> {{f.business_impact}}</p><p><b>Remediation:</b> {{f.remediation}}</p><h3>PoC request</h3><pre>{{f.poc_request}}</pre><h3>Response evidence</h3><pre>{{f.poc_response_snippet}}</pre></article>{% endfor %}<h2>Testing Methodology / Audit Log</h2><pre>{{audit_log}}</pre></body></html>
